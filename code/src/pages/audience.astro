---
import '../styles.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>Slides — Audience</title>
  </head>
  <body>
    <main class="audience-page">
      <div class="audience-bar">
        <form id="viewer-form" class="viewer-bar" hidden>
          <label for="viewer-name">Your name</label>
          <input id="viewer-name" maxlength="40" autocomplete="nickname" placeholder="Guest" />
          <button type="submit">Set name</button>
        </form>
        <ul id="viewer-list" class="viewer-list" aria-label="Viewers"></ul>
      </div>
      <p id="audience-status" role="status" aria-live="polite">Connecting to presentation…</p>
      <div class="audience-fit">
        <div id="audience-frame" class="stage-frame" aria-label="Audience slide">
          <div id="audience-stage" class="stage"></div>
          <svg id="audience-ink" class="ink" viewBox="0 0 1000 562.5" preserveAspectRatio="none" aria-hidden="true"></svg>
          <div id="audience-mode" class="stage-mode" hidden></div>
        </div>
      </div>
    </main>
    <script>import '../audience.ts';</script>
  </body>
</html>
