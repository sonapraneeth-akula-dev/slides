{
  "name": "slides",
  "private": true,
  "packageManager": "bun@1.4.5",
  "type": "module",
  "scripts": {
    "format": "bun fmt --no-script",
    "format:check": "bun fmt --no-script --check",
    "typecheck:ts": "bun check --no-script",
    "dev": "bun ./scripts/dev.ts",
    "check": "astro check",
    "build": "astro build && bun ./scripts/audience-assets.ts && bun build ./src/host.ts --target=bun --outfile ./build/host.js",
    "start": "bun ./build/host.js",
    "test": "bun test ./tests",
    "test:e2e": "bun run build && playwright test"
  },
  "dependencies": {
    "astro": "7.4.12",
    "dompurify": "^3.4.18",
    "echarts": "^6.1.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "mermaid": "^12.3.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.65.1",
    "@types/bun": "1.4.4",
    "@types/dompurify": "^3.2.0",
    "@types/highlight.js": "^10.1.0",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "~6.0.3"
  }
}
